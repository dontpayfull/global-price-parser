{
  "name": "dontpayfull/global-price-parser",
  "description": "Read prices, currencies and page signals from text or HTML worldwide.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://www.dontpayfull.com/labs/global-price-parser/",
  "authors": [
    {
      "name": "DontPayFull",
      "homepage": "https://www.dontpayfull.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "DontPayFull\\GlobalPriceParser\\": "php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DontPayFull\\GlobalPriceParser\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "phpunit --bootstrap php/vendor/autoload.php php/tests"
  },
  "config": {
    "vendor-dir": "php/vendor",
    "lock": false
  }
}
